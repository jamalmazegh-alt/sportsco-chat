+import { describe, it, expect, vi, beforeEach } from "vitest";
+import { PUBLIC_TOURNAMENT_STATUSES } from "@/modules/tournaments/lib/public-tournament";
+
+const tournamentRow = vi.hoisted(() => ({
+  value: null as Record<string, unknown> | null,
+}));
+
+const lastSelect = vi.hoisted(() => ({ value: "" }));
+
+const clubsRow = vi.hoisted(() => ({
+  value: null as { logo_url: string | null } | null,
+}));
+
+const downloadMock = vi.hoisted(() => vi.fn());
+const storageFromMock = vi.hoisted(() => vi.fn(() => ({ download: downloadMock })));
+
+vi.mock("@/integrations/supabase/client.server", () => {
+  const from = (table: string) => {
+    if (table === "tournaments") {
+      return {
+        select: (cols: string) => {
+          lastSelect.value = cols;
+          return {
+            eq: () => ({
+              in: (_col: string, statuses: string[]) => ({
+                maybeSingle: async () => {
+                  const row = tournamentRow.value;
+                  if (!row) return { data: null, error: null };
+                  if (!statuses.includes(String(row.status))) return { data: null, error: null };
+                  return { data: row, error: null };
+                },
+              }),
+            }),
+          };
+        },
+      };
+    }
+    if (table === "clubs") {
+      return {
+        select: () => ({
+          eq: () => ({
+            maybeSingle: async () => ({ data: clubsRow.value, error: null }),
+          }),
+        }),
+      };
+    }
+    throw new Error(`unexpected table ${table}`);
+  };
+  return {
+    supabaseAdmin: {
+      from,
+      storage: { from: (...args: unknown[]) => storageFromMock(...args) },
+    },
+  };
+});
+
+const fetchUploadedRegulationsPdfMock = vi.hoisted(() => vi.fn());
+const fetchImageBytesMock = vi.hoisted(() => vi.fn());
+
+vi.mock("@/lib/safe-remote-asset.server", async () => {
+  const actual = await vi.importActual<typeof import("@/lib/safe-remote-asset.server")>(
