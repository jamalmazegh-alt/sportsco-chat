+    qualification: { perGroup: 2, bestThirds: 0 },
+    fairPlay: { yellow: -1, secondYellow: -3, red: -5 },
+    overtime: { enabled: false },
+    penaltyShootout: { enabled: true },
+    roster: { playersPerTeam: 11, maxSubstitutes: 5 },
+  },
+  club_id: null,
+  cover_image_url: null,
+};
+
+beforeEach(() => {
+  tournamentRow.value = null;
+  lastSelect.value = "";
+  clubsRow.value = null;
+  downloadMock.mockReset();
+  storageFromMock.mockClear();
+  fetchUploadedRegulationsPdfMock.mockReset();
+  fetchImageBytesMock.mockReset();
+  fetchImageBytesMock.mockResolvedValue(null);
+});
+
+describe("GET /api/public/tournament/$id/regulations", () => {
+  for (const status of ["draft", "cancelled"] as const) {
+    it(`returns identical 404 for ${status} tournaments`, async () => {
+      tournamentRow.value = { ...baseTournament, id: DRAFT_ID, status };
+      const handler = await loadHandler();
+      const res = await handler(makeReq(DRAFT_ID));
+      expect(res.status).toBe(404);
+      expect(await res.text()).toBe("");
+    });
+  }
+
+  it("returns identical 404 for unknown tournament id", async () => {
+    tournamentRow.value = null;
+    const handler = await loadHandler();
+    const res = await handler(makeReq(MISSING_ID));
+    expect(res.status).toBe(404);
+    expect(await res.text()).toBe("");
+  });
+
+  it("returns 404 for draft vs missing with identical body (no oracle)", async () => {
+    tournamentRow.value = { ...baseTournament, id: DRAFT_ID, status: "draft" };
+    const handler = await loadHandler();
+    const draftRes = await handler(makeReq(DRAFT_ID));
+    tournamentRow.value = null;
+    const missingRes = await handler(makeReq(MISSING_ID));
+    expect(draftRes.status).toBe(404);
+    expect(missingRes.status).toBe(404);
+    expect(await draftRes.text()).toBe(await missingRes.text());
+  });
+
+  for (const status of PUBLIC_TOURNAMENT_STATUSES) {
+    it(`allows public status ${status} to reach PDF generation`, async () => {
+      tournamentRow.value = { ...baseTournament, status };
+      const handler = await loadHandler();
+      const res = await handler(makeReq(PUBLIC_ID));
+      expect(res.status).toBe(200);
+      expect(res.headers.get("Content-Type")).toBe("application/pdf");
+    });
+  }
+
+  it("streams uploaded regulations via storage helper (no raw uploadedUrl fetch in route)", async () => {
+    const uploadedUrl = `https://x.supabase.co/storage/v1/object/public/tournament-documents/${PUBLIC_ID}/regulations/x.pdf`;
+    tournamentRow.value = {
+      ...baseTournament,
+      status: "published",
+      settings: {
+        ...baseTournament.settings,
+        regulations: {
+          mode: "uploaded",
+          uploadedUrl,
+          uploadedName: "rules.pdf",
+          uploadedAt: new Date().toISOString(),
+        },
+      },
+    };
+    const pdf = new Uint8Array([0x25, 0x50, 0x44, 0x46]);
+    fetchUploadedRegulationsPdfMock.mockResolvedValueOnce(pdf.buffer);
+
+    const handler = await loadHandler();
+    const res = await handler(makeReq(PUBLIC_ID));
+
+    expect(res.status).toBe(200);
+    expect(fetchUploadedRegulationsPdfMock).toHaveBeenCalledWith(uploadedUrl, PUBLIC_ID);
+    expect(res.headers.get("Content-Type")).toBe("application/pdf");
+  });
+
+  it("uses explicit select list (no select *)", async () => {
+    tournamentRow.value = { ...baseTournament, status: "published" };
+    const handler = await loadHandler();
+    await handler(makeReq(PUBLIC_ID));
+    expect(lastSelect.value).not.toContain("*");
+    expect(lastSelect.value).toContain("settings");
+    expect(lastSelect.value).not.toContain("created_by");
+    expect(lastSelect.value).not.toContain("stripe");
+  });
+});
diff --git a/src/tests/unit/safe-login-redirect.test.ts b/src/tests/unit/safe-login-redirect.test.ts
new file mode 100644
index 00000000..945af692
--- /dev/null
+++ b/src/tests/unit/safe-login-redirect.test.ts
@@ -0,0 +1,67 @@
+import { describe, it, expect } from "vitest";
+import {
+  loginRedirectOrigin,
+  parseLoginNextSearchParam,
+  resolveSafeLoginRedirect,
+} from "@/lib/safe-login-redirect";
+
+const ORIGIN = "https://app.clubero.app";
+
+describe("resolveSafeLoginRedirect", () => {
+  it("accepts safe in-app paths", () => {
+    expect(resolveSafeLoginRedirect("/dashboard", ORIGIN)).toBe("/dashboard");
+    expect(resolveSafeLoginRedirect("/clubs/123/events", ORIGIN)).toBe("/clubs/123/events");
+    expect(resolveSafeLoginRedirect("/home?tab=1#x", ORIGIN)).toBe("/home?tab=1#x");
+  });
+
+  it("rejects protocol-relative and absolute URLs", () => {
+    expect(resolveSafeLoginRedirect("//evil.com", ORIGIN)).toBeUndefined();
+    expect(resolveSafeLoginRedirect("https://evil.com", ORIGIN)).toBeUndefined();
+    expect(resolveSafeLoginRedirect("http:evil.com", ORIGIN)).toBeUndefined();
+    expect(resolveSafeLoginRedirect("javascript:alert(1)", ORIGIN)).toBeUndefined();
+    expect(resolveSafeLoginRedirect("data:text/html,hi", ORIGIN)).toBeUndefined();
+  });
+
+  it("rejects backslash and encoded bypass attempts", () => {
+    expect(resolveSafeLoginRedirect("/\\evil.com", ORIGIN)).toBeUndefined();
+    expect(resolveSafeLoginRedirect("/\\/\\evil.com", ORIGIN)).toBeUndefined();
+    expect(resolveSafeLoginRedirect("%2F%2Fevil.com", ORIGIN)).toBeUndefined();
+    expect(resolveSafeLoginRedirect("%5Cevil.com", ORIGIN)).toBeUndefined();
+    expect(resolveSafeLoginRedirect("/%2F%2Fevil.com", ORIGIN)).toBeUndefined();
+  });
+
+  it("rejects leading whitespace before protocol-relative paths", () => {
+    expect(resolveSafeLoginRedirect(" //evil.com", ORIGIN)).toBeUndefined();
+    expect(resolveSafeLoginRedirect("\t//evil.com", ORIGIN)).toBeUndefined();
+    expect(resolveSafeLoginRedirect("\n//evil.com", ORIGIN)).toBeUndefined();
+  });
+
+  it("parseLoginNextSearchParam uses canonical origin and rejects unsafe values", () => {
+    expect(parseLoginNextSearchParam("/events")).toBe("/events");
+    expect(parseLoginNextSearchParam("//evil.com")).toBeUndefined();
+    expect(loginRedirectOrigin()).toMatch(/^https:\/\//);
+  });
+});
+
+describe("login and register validateSearch parity", () => {
+  const cases: Array<{ raw: string; ok: boolean }> = [
+    { raw: "//evil.com", ok: false },
+    { raw: "/\\evil.com", ok: false },
+    { raw: "%2F%2Fevil.com", ok: false },
+    { raw: "https://evil.com", ok: false },
+    { raw: " //evil.com", ok: false },
+    { raw: "/dashboard", ok: true },
+    { raw: "/clubs/123/events", ok: true },
+  ];
+
+  for (const { raw, ok } of cases) {
+    it(`${ok ? "accepts" : "rejects"} ${JSON.stringify(raw)}`, () => {
+      const parsed = parseLoginNextSearchParam(raw);
+      if (ok) {
+        expect(parsed).toBe(raw.startsWith("/") ? raw : undefined);
+      } else {
+        expect(parsed).toBeUndefined();
+      }
+    });
+  }
+});
diff --git a/src/tests/unit/safe-remote-asset.test.ts b/src/tests/unit/safe-remote-asset.test.ts
new file mode 100644
index 00000000..6cca0837
--- /dev/null
+++ b/src/tests/unit/safe-remote-asset.test.ts
@@ -0,0 +1,135 @@
+import { describe, it, expect, vi, beforeEach } from "vitest";
+import {
+  fetchBytesSsrfSafe,
+  fetchImageBytes,
+  fetchUploadedRegulationsPdf,
+  isBlockedFetchHostname,
+  isSafeHttpsUrl,
+} from "@/lib/safe-remote-asset.server";
+
+const downloadMock = vi.fn();
+const storageFromMock = vi.fn(() => ({ download: downloadMock }));
+
+vi.mock("@/integrations/supabase/client.server", () => ({
+  supabaseAdmin: {
+    storage: { from: (...args: unknown[]) => storageFromMock(...args) },
+  },
+}));
+
+const fetchMock = vi.fn();
+vi.stubGlobal("fetch", fetchMock);
+
+beforeEach(() => {
+  downloadMock.mockReset();
+  storageFromMock.mockClear();
+  fetchMock.mockReset();
+});
+
+describe("isBlockedFetchHostname", () => {
+  it("blocks loopback, link-local and metadata hosts", () => {
+    expect(isBlockedFetchHostname("127.0.0.1")).toBe(true);
+    expect(isBlockedFetchHostname("169.254.169.254")).toBe(true);
+    expect(isBlockedFetchHostname("10.0.0.5")).toBe(true);
+    expect(isBlockedFetchHostname("metadata.google.internal")).toBe(true);
+    expect(isBlockedFetchHostname("localhost")).toBe(true);
+  });
+
+  it("allows public hostnames", () => {
+    expect(isBlockedFetchHostname("cdn.example.com")).toBe(false);
+  });
+});
+
+describe("fetchBytesSsrfSafe", () => {
+  it("rejects non-https and internal targets", async () => {
+    expect(await fetchBytesSsrfSafe("http://example.com/x")).toBeNull();
+    expect(await fetchBytesSsrfSafe("https://127.0.0.1/internal")).toBeNull();
+    expect(await fetchBytesSsrfSafe("https://169.254.169.254/latest/meta-data/")).toBeNull();
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+
+  it("rejects redirects to internal targets (manual redirect handling)", async () => {
+    fetchMock.mockResolvedValueOnce(
+      new Response(null, {
+        status: 302,
+        headers: { Location: "https://169.254.169.254/secret" },
+      }),
+    );
+
+    const bytes = await fetchBytesSsrfSafe("https://allowed.example.com/start");
+    expect(bytes).toBeNull();
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+    expect(fetchMock.mock.calls[0]?.[1]).toMatchObject({ redirect: "manual" });
+  });
+
+  it("rejects non-matching Content-Type", async () => {
+    fetchMock.mockResolvedValueOnce(
+      new Response(new Uint8Array([1, 2, 3]), {
+        status: 200,
+        headers: { "Content-Type": "text/html" },
+      }),
+    );
+
+    const bytes = await fetchBytesSsrfSafe("https://allowed.example.com/doc", {
+      allowedContentTypePrefixes: ["application/pdf"],
+    });
+    expect(bytes).toBeNull();
+  });
+});
+
+describe("fetchImageBytes storage-backed path", () => {
+  it("downloads club logos from storage without HTTP fetch", async () => {
+    const png = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]);
+    downloadMock.mockResolvedValueOnce({ data: new Blob([png]), error: null });
+
+    const url =
+      "https://project.supabase.co/storage/v1/object/public/club-logos/club-1/logo.png";
+    const result = await fetchImageBytes(url);
+
+    expect(result?.kind).toBe("png");
+    expect(storageFromMock).toHaveBeenCalledWith("club-logos");
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+
+  it("falls back to SSRF-safe HTTPS fetch for non-storage URLs", async () => {
+    const png = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]);
+    fetchMock.mockResolvedValueOnce(
+      new Response(png, {
+        status: 200,
+        headers: { "Content-Type": "image/png" },
+      }),
+    );
+
+    const result = await fetchImageBytes("https://cdn.example.com/logo.png");
+    expect(result?.kind).toBe("png");
+    expect(isSafeHttpsUrl("https://cdn.example.com/logo.png")).toBe(true);
+  });
+});
+
+describe("fetchUploadedRegulationsPdf", () => {
+  it("downloads tournament regulations from storage when path matches tournament", async () => {
+    const pdf = new Uint8Array([0x25, 0x50, 0x44, 0x46]);
+    downloadMock.mockResolvedValueOnce({ data: new Blob([pdf]), error: null });
+
+    const tid = "11111111-1111-1111-1111-111111111111";
+    const url = `https://project.supabase.co/storage/v1/object/public/tournament-documents/${tid}/regulations/a.pdf`;
+
+    const bytes = await fetchUploadedRegulationsPdf(url, tid);
+    expect(bytes).not.toBeNull();
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+
+  it("rejects storage path for a different tournament id", async () => {
+    fetchMock.mockResolvedValueOnce(
+      new Response(new Uint8Array([0x25, 0x50, 0x44, 0x46]), {
+        status: 200,
+        headers: { "Content-Type": "application/pdf" },
+      }),
+    );
+
+    const url =
+      "https://project.supabase.co/storage/v1/object/public/tournament-documents/other-id/regulations/a.pdf";
+    await fetchUploadedRegulationsPdf(url, "11111111-1111-1111-1111-111111111111");
+    expect(downloadMock).not.toHaveBeenCalled();
+    expect(fetchMock).toHaveBeenCalled();
+  });
+});
