+    .handlers.GET;
+}
+
+function makeReq(id: string, lang = "fr"): { request: Request; params: { id: string } } {
+  return {
+    request: new Request(`http://localhost/api/public/tournament/${id}/regulations?lang=${lang}`),
+    params: { id },
+  };
+}
+
+const PUBLIC_ID = "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa";
+const DRAFT_ID = "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb";
+const MISSING_ID = "cccccccc-cccc-cccc-cccc-cccccccccccc";
+
+const baseTournament = {
