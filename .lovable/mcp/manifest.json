{
  "version": 1,
  "sdk_version": "0.20.1",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "clubero-mcp",
      "version": "0.1.0",
      "title": "Clubero"
    },
    "tools": [
      {
        "name": "ping",
        "title": "Ping",
        "description": "Health check for the Clubero MCP server. Returns 'pong' plus any provided note.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "note": {
              "description": "Optional note to echo back.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_public_tournaments",
        "title": "List public tournaments",
        "description": "List upcoming public tournaments visible on Clubero, ordered by start date.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max rows to return (1-50, default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
