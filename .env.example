# Public, build-time env (safe to ship to the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side mirror used by the TanStack server runtime
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# === Server-only secrets — NEVER commit real values. Configure them in the
# hosting environment / Supabase Edge Function Secrets, not in this repo. ===
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (platform account + Connect)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Cron / public hook secrets
DATA_RETENTION_SECRET=
EVENT_REMINDERS_SECRET=
TRIAL_REMINDERS_SECRET=
PAYMENT_REMINDERS_SECRET=
COACH_INSIGHTS_SECRET=
SOCIAL_SYNC_SECRET=

# Lovable AI Gateway
LOVABLE_API_KEY=

# === Météo (Open-Meteo) ===
# Clé du plan commercial. Sans elle, les appels partent vers l'API publique,
# dont les conditions d'utilisation sont réservées au non-commercial : à
# renseigner avant toute mise en production. Sans clé comme sans réseau, la
# météo ne s'affiche simplement pas — aucune autre fonctionnalité n'en dépend.
OPEN_METEO_API_KEY=

# === Email provider selection ===
EMAIL_PROVIDER=lovable
AWS_SES_REGION=eu-west-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_FROM_DOMAIN=send.clubero.app
AWS_SES_CONFIGURATION_SET=
SES_SNS_SECRET=
SES_SNS_TOPIC_ARN=

# Optional app config
APP_URL=

VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Notifications push — trois canaux, trois configurations distinctes.
# Ces valeurs sont des secrets côté serveur : en production elles vivent dans
# les variables d'environnement de la plateforme de déploiement, jamais ici.

# Canal `web` — Web Push VAPID, navigateurs et PWA.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Canal `fcm` — Android natif, via Firebase Cloud Messaging HTTP v1.
# Extraits du JSON de compte de service Firebase ; le JSON lui-même n'entre
# jamais dans le dépôt, contrairement à google-services.json qui, lui, ne
# contient aucun secret.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Canal `apns` — iOS natif, en direct chez Apple.
# Le plugin Capacitor iOS renvoie un jeton d'appareil APNs, que FCM n'accepte
# pas : ce canal ne passe donc pas par Firebase. APNS_PRIVATE_KEY prend le
# CONTENU du fichier .p8, pas son chemin.
# APNS_SANDBOX=1 vise le bac à sable, pour déboguer sur un appareil branché
# en mode développement — à laisser absente pour TestFlight et l'App Store,
# les deux environnements étant étanches.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.clubero.mobile
APNS_PRIVATE_KEY=
APNS_SANDBOX=
