# Public, build-time env (safe to ship to the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side mirror used by the TanStack server runtime
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# === Server-only secrets — NEVER commit real values. Configure them in the
# hosting environment / Supabase Edge Function Secrets, not in this repo. ===
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (platform account + Connect)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Cron / public hook secrets
DATA_RETENTION_SECRET=
EVENT_REMINDERS_SECRET=
TRIAL_REMINDERS_SECRET=
PAYMENT_REMINDERS_SECRET=
COACH_INSIGHTS_SECRET=
SOCIAL_SYNC_SECRET=

# Lovable AI Gateway
LOVABLE_API_KEY=

# === Email provider selection ===
EMAIL_PROVIDER=lovable
AWS_SES_REGION=eu-west-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_FROM_DOMAIN=send.clubero.app
AWS_SES_CONFIGURATION_SET=
SES_SNS_SECRET=
SES_SNS_TOPIC_ARN=

# Optional app config
APP_URL=

VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
